ecosystem.config.js
musicstore.service
nginx.conf
backup-cron.sh
DEPLOY.md

# File di test/debug locale
check-ops.js
test-pdfjs.mjs
real-test.pdf
catalog-screenshot.png
cover-test.png
*.log