# Dipendenze e build artifacts — installati dentro l'immagine
node_modules/
npm-debug.log*

# Dati locali (non copiare DB/PDF/cache nell'immagine)
data/

# Segreti — NON entrano nell'immagine (passati a runtime via env_file)
