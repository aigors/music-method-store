[Unit]
Description=iVentoy PXE Network Boot Server
After=network.target
Wants=network.target

[Service]
Type=simple
EnvironmentFile=-/var/packages/iventoy/var/iventoy.conf
ExecStartPre=/bin/sh -c 'mkdir -p ${IVENTOY_ISO_DIR} /var/packages/iventoy/var/log/client /var/packages/iventoy/var/log/history'
ExecStart=/var/packages/iventoy/target/iventoy-wrapper.sh -R start
ExecStop=/var/packages/iventoy/target/iventoy-wrapper.sh stop
PIDFile=/var/run/iventoy.pid
User=root
Group=root
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=iventoy

CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_NET_ADMIN CAP_NET_RAW CAP_DAC_OVERRIDE
AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_NET_ADMIN CAP_NET_RAW CAP_DAC_OVERRIDE

LimitNOFILE=65536
LimitNPROC=4096

[Install]
WantedBy=multi-user.target