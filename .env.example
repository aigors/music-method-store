# ============================================================
# Music Method Store — configurazione
# Copia questo file in ".env" e compila i valori.
# ============================================================

# Porta del server
PORT=3000

# URL pubblico del servizio (usato per link PayPal e notifiche)
BASE_URL=http://localhost:3000

# NODE_ENV=production attiva: cookie "secure" (HTTPS obbligatorio),
# header di sicurezza rigorosi, ecc.
NODE_ENV=development

# Segreto per le sessioni. GENERA UNA STRINGA CASUALE LUNGA:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=cambia-questo-con-una-stringa-casuale-lunga

# Percorsi dati (di default dentro ./data, NON serviti pubblicamente)
# DB_PATH=./data/db.sqlite
# PDF_DIR=./data/pdfs
# CACHE_DIR=./data/cache

# ------------------------------------------------------------
# SMTP per l'invio del codice 2FA via e-mail.
# Se lasci SMTP_HOST vuoto, l'app gira in MODALITA' DEMO:
# il codice viene stampato nei log del server (utile per i test).
# Esempio con Gmail (serve una "App password", non quella normale):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=tuo@email.it
#   SMTP_PASS=la-tua-app-password
#   SMTP_FROM=Music Method Store <tuo@email.it>
# ------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=true
SMTP_USER=dude68.ac@gmail.com
SMTP_PASS=mory ayvm knxd efwl
SMTP_FROM=Music Method Store <dude68.ac@gmail.com>

# ------------------------------------------------------------
# PayPal — MODALITA' SANDBOX (test).
# Le credenziali si prendono da https://developer.paypal.com →
# App & Credentials → Sandbox. Crea un'App per ottenere
# CLIENT ID e SECRET, e un account "buyer" da Sandbox → Accounts.
#
# Nota: in questa app la client-id viene esposta al browser
# tramite /api/config (è pubblica per natura). Il SECRET resta
# solo sul server.
# ------------------------------------------------------------
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=AeDakFSnWg0q1wdqHS-Gc9ZPTEm9-avlRxuEbwf9g2loP23v-je1wzJFuZtJfhvaUwl1uUt-F1ohN-_p
PAYPAL_CLIENT_SECRET=EFzbyeP0ZQuh1KLUtoaYNL4Hi00REbK4_RPhNg4Ryj_YYOn6SJBmPl2A4o-GD5Cp6PjLpVeqpg0dG1ot

# Webhook PayPal (opzionale): lo si configura nel dashboard PayPal
# puntando a https://TUODOMINIO/api/pay/webhook. Serve a mantenere
# gli accessi allineati anche per pagamenti asincroni.
PAYPAL_WEBHOOK_ID=
