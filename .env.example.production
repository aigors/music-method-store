# ============================================================
# Music Method Store — Variabili d'ambiente PRODUZIONE
# Copia in .env e compila TUTTI i valori
# ============================================================

# --- App ---
NODE_ENV=production
PORT=3000

# SESSION_SECRET: genera con `openssl rand -hex 32` (64 char hex)
SESSION_SECRET=

# --- Database & Storage (directory fuori dal repo, persistenti) ---
DB_PATH=/var/lib/musicstore/db.sqlite
PDF_DIR=/var/lib/musicstore/pdfs
CACHE_DIR=/var/lib/musicstore/cache

# --- SMTP per 2FA email (OBBLIGATORIO in produzione) ---
# Usa un servizio transactional: SendGrid, Mailgun, Postmark, Brevo, SMTP del tuo hosting
SMTP_HOST=smtp.tuodominio.it
SMTP_PORT=587
SMTP_USER=noreply@tuodominio.it
SMTP_PASS=
SMTP_FROM="Music Store <noreply@tuodominio.it>"

# --- PayPal LIVE (non sandbox!) ---
# Crea app su https://developer.paypal.com/ → My Apps & Credentials → Live
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=live
# Webhook ID: configura su PayPal Developer → Webhooks → URL: https://shop.tuodominio.it/api/paypal/webhook
PAYPAL_WEBHOOK_ID=

# --- Opzionale: logging/debug ---
# LOG_LEVEL=info
# DEBUG=musicstore:*